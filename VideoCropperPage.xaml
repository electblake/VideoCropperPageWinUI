<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VideoCropper.VideoCropperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:sizers="using:CommunityToolkit.WinUI.Controls"
    xmlns:videoCropper="using:VideoCropper"
    xmlns:timeline="using:Timeline"
    xmlns:controls="using:WinUIShared.Controls"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:BoolNegationConverter x:Key="BoolNegationConverter" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#242424" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="480"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="400" MinWidth="320"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.ColumnSpan="3" Margin="10" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button HorizontalAlignment="Left" Click="GoBack">
                <StackPanel Orientation="Horizontal">
                    <FontIcon Glyph="&#xE72B;" Margin="0,0,10,0" />
                    <TextBlock VerticalAlignment="Center">Go back</TextBlock>
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="1" Name="VideoName" VerticalAlignment="Center"
                       Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" ToolTipService.ToolTip="{Binding Text, ElementName=VideoName}"/>
            <StackPanel x:Name="VideoNavigation" Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="PreviousVideoButton" Click="PreviousVideo" ToolTipService.ToolTip="Previous video">
                    <FontIcon Glyph="&#xE76B;"/>
                </Button>
                <Button x:Name="NextVideoButton" Click="NextVideo" ToolTipService.ToolTip="Next video">
                    <FontIcon Glyph="&#xE76C;"/>
                </Button>
            </StackPanel>
        </Grid>
        <RelativePanel Grid.Row="1">
            <Grid Name="CanvasContainer" RelativePanel.AlignTopWithPanel="True" RelativePanel.AlignRightWithPanel="True" RelativePanel.AlignLeftWithPanel="True"
                  RelativePanel.Above="VideoControls" SizeChanged="CanvasContainer_OnSizeChanged"
                  PointerWheelChanged="CanvasContainer_OnPointerWheelChanged">
                <Canvas Name="Canvas" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="PanTransform" X="0" Y="0"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <MediaPlayerElement Name="VideoPlayer" SizeChanged="VideoPlayer_OnSizeChanged"/>
                    <Path Fill="#77000000" Name="OverlayAndMask"/>
                    <RelativePanel Name="CropFrame" BorderBrush="White" BorderThickness="3" Background="Transparent">
                        <Rectangle Width="40" Height="3" Fill="White" RelativePanel.AlignTopWithPanel="True" RelativePanel.AlignHorizontalCenterWithPanel="True"></Rectangle>
                        <Rectangle Width="40" Height="3" Fill="White" RelativePanel.AlignBottomWithPanel="True" RelativePanel.AlignHorizontalCenterWithPanel="True"></Rectangle>
                        <Rectangle Height="40" Width="3" Fill="White" RelativePanel.AlignLeftWithPanel="True" RelativePanel.AlignVerticalCenterWithPanel="True"></Rectangle>
                        <Rectangle Height="40" Width="3" Fill="White" RelativePanel.AlignRightWithPanel="True" RelativePanel.AlignVerticalCenterWithPanel="True"></Rectangle>
                        <Path Data="M0,0 L0,30 L3,30 L3,3 L30,3 L30,0 Z" Fill="White"></Path>
                        <Path Data="M30,0 L30,30 L27,30 L27,3 L0,3 L0,0 Z" Fill="White" RelativePanel.AlignRightWithPanel="True"></Path>
                        <Path Data="M0,30 L0,0 L3,0 L3,27 L30,27 L30,30 Z" Fill="White" RelativePanel.AlignBottomWithPanel="True"></Path>
                        <Path Data="M30,30 L30,0 L27,0 L27,27 L0,27 L0,30 Z" Fill="White" RelativePanel.AlignBottomWithPanel="True" RelativePanel.AlignRightWithPanel="True"></Path>
                    </RelativePanel>
                </Canvas>
            </Grid>
            <timeline:VideoControls x:Name="VideoControls" MediaPlayer="{x:Bind VideoPlayer.MediaPlayer}" RelativePanel.AlignRightWithPanel="True"
                                    RelativePanel.AlignLeftWithPanel="True" RelativePanel.Above="ProcessManager" Height="50" Margin="10,0"/>
            <controls:ProcessManager x:Name="ProcessManager" State="{x:Bind viewModel.State, Mode=TwoWay}" RelativePanel.AlignBottomWithPanel="True"
                                     RelativePanel.AlignLeftWithPanel="True" RelativePanel.AlignRightWithPanel="True"
                                     Processor="{x:Bind cropProcessor}" HardwareSelector="{x:Bind HardwareSelector}"
                                     OnlyPrimary="True" Padding="10" DoneRequested="GoBack"/>
        </RelativePanel>
        <sizers:GridSplitter Grid.Row="1" Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
        <Grid Grid.Row="1" Grid.Column="2" Padding="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TabView IsAddTabButtonVisible="False" TabWidthMode="Equal" Margin="0,0,0,10">
                <TabViewItem Header="Crop" IsClosable="False">
                    <ScrollView Background="{StaticResource PanelBackgroundBrush}">
                        <StackPanel Spacing="10" Padding="0,10,0,0">
                            <RelativePanel Height="150">
                                <NumberBox Name="X" Header="X" Width="140" LostFocus="X_OnTextChanged" SpinButtonPlacementMode="Compact" LargeChange="20"/>
                                <NumberBox Name="Y" Header="Y" Width="140" LostFocus="Y_OnTextChanged" RelativePanel.AlignRightWithPanel="True" SpinButtonPlacementMode="Compact" LargeChange="20"/>
                                <NumberBox Name="XDelta" Header="Width" Width="140" LostFocus="XDelta_OnTextChanged" RelativePanel.AlignBottomWithPanel="True"
                                           SpinButtonPlacementMode="Compact" LargeChange="20"/>
                                <NumberBox Name="YDelta" Header="Height" Width="140" LostFocus="YDelta_OnTextChanged" RelativePanel.AlignRightWithPanel="True"
                                           RelativePanel.AlignBottomWithPanel="True" SpinButtonPlacementMode="Compact" LargeChange="20"/>
                            </RelativePanel>
                            <CheckBox Name="AspectRatioCheckBox" Content="Lock aspect ratio"
                                      Checked="AspectRatioCheckBox_OnChanged" Unchecked="AspectRatioCheckBox_OnChanged"/>
                            <GridView ItemsSource="{x:Bind ratios}">
                                <GridView.ItemContainerStyle>
                                    <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                                        <Setter Property="Margin" Value="5, 5, 5, 5" />
                                    </Style>
                                </GridView.ItemContainerStyle>
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid MaximumRowsOrColumns="4" Orientation="Horizontal"
                                                       HorizontalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="videoCropper:AspectRatio">
                                        <ToggleButton Padding="10" Width="70" Height="100" CornerRadius="10" Click="SpecificRatio"
                                                      IsChecked="{x:Bind IsSelected, Mode=OneWay}">
                                            <StackPanel Spacing="10">
                                                <Grid Height="40">
                                                    <Rectangle Width="{x:Bind Width}" Height="{x:Bind Height}" Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                                               StrokeThickness="2" RadiusX="3" RadiusY="3" />
                                                </Grid>
                                                <TextBlock HorizontalTextAlignment="Center"
                                                           Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Title}">
                                                </TextBlock>
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                            <ToggleButton x:Name="CenterFrameToggleButton" HorizontalAlignment="Center" Click="CenterFrame">
                                <StackPanel Orientation="Horizontal">
                                    <SymbolIcon Symbol="AlignCenter" Margin="0,0,10,0" />
                                    <TextBlock VerticalAlignment="Center">Center Frame</TextBlock>
                                </StackPanel>
                            </ToggleButton>
                            <CheckBox x:Name="ZoomIntoFrameCheckBox" Content="Zoom into frame"
                                      Checked="ZoomFrameCheckBox_OnChanged" Unchecked="ZoomFrameCheckBox_OnChanged"/>
                        </StackPanel>
                    </ScrollView>
                </TabViewItem>
                <TabViewItem Header="Settings" IsClosable="False">
                    <ScrollView Background="{StaticResource PanelBackgroundBrush}">
                        <StackPanel Spacing="10" Padding="0,10,0,0">
                            <CheckBox x:Name="MouseWheelZoomCheckBox" Content="Use mouse scroll wheel to zoom"
                                      Checked="MouseWheelZoomCheckBox_OnChanged" Unchecked="MouseWheelZoomCheckBox_OnChanged"/>
                            <CheckBox x:Name="NormalizePixelAspectRatioCheckBox" Content="Convert output to square pixels (SAR 1:1)"
                                      Checked="NormalizePixelAspectRatioCheckBox_OnChanged" Unchecked="NormalizePixelAspectRatioCheckBox_OnChanged"/>
                            <controls:HardwareSelector x:Name="HardwareSelector"/>
                        </StackPanel>
                    </ScrollView>
                </TabViewItem>
            </TabView>
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="Crop"
                        IsEnabled="{x:Bind viewModel.DuringOperation, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Viewbox MaxWidth="30">
                            <SymbolIcon Symbol="Crop" />
                        </Viewbox>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" HorizontalTextAlignment="Center">Crop!</TextBlock>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="BatchCrop"
                        IsEnabled="{x:Bind viewModel.DuringOperation, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Viewbox MaxWidth="30">
                            <SymbolIcon Symbol="Crop" />
                        </Viewbox>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" HorizontalTextAlignment="Center">Batch crop</TextBlock>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>
